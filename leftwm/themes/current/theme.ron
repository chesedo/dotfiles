#![enable(implicit_some)]

// Colours here duplicate the base16 scheme in
// home-manager/theme/alpine-slate.nix, because leftwm reads this file directly
// and the leftwm directory is an out-of-store symlink, so Nix cannot template
// it. Keep in sync by hand: base01, base0E, base0D.
(border_width: 0,
margin: 32,
default_border_color: "#1F232A",
floating_border_color: "#9C7FA6",
focused_border_color: "#5F87AE",
)
